{
  "name": "cookiecleaner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --build",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node scripts/test-browser.mjs",
    "build": "npm run type-check && vite build",
    "build:icons": "node scripts/convert-icons.js",
    "build:extension": "npm run type-check && npm run build:icons && vite build --outDir dist-extension && vite build --config vite.background.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.2",
    "chrome-extension-component-library": "https://github.com/larsliin/ChromeExtensionComponentLibrary/releases/download/v0.2.0/chrome-extension-component-library-0.2.0.tgz",
    "vue": "^3.5.44",
    "tldts": "^7.0.19"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/chrome": "^0.1.31",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "sharp": "^0.35.5",
    "playwright-core": "^1.56.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
