{
  "manifest_version": 3,
  "name": "Cookie Cleaner",
  "version": "0.0.0",
  "description": "Remove cookies, local storage, and session storage for the current domain.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Cookie Cleaner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["cookies", "scripting", "activeTab"]
}
